{
  "name": "sauda",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm -r typecheck && pnpm -r test",
    "gate:ip": "pnpm --filter @sauda/engine test ip-guard",
    "gate": "pnpm gate:ip && pnpm -r typecheck && pnpm lint && pnpm -r test",
    "play": "pnpm --filter @sauda/tools play",
    "simulate": "pnpm --filter @sauda/tools simulate",
    "capture": "pnpm --filter @sauda/mobile capture",
    "capture:phone": "pnpm --filter @sauda/mobile capture:phone",
    "capture:phone2": "pnpm --filter @sauda/mobile capture:phone2",
    "capture:shell": "pnpm --filter @sauda/mobile capture:shell",
    "capture:landscape": "pnpm --filter @sauda/mobile capture:landscape",
    "dev:lan": "pnpm --filter @sauda/mobile dev:lan",
    "phone": "pnpm --filter @sauda/mobile phone:connect",
    "plates:variants": "pnpm --filter @sauda/mobile plates:variants"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
